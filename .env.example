# Neon PostgreSQL: Dashboard > Connection Details > copy the pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Seed admin login (used to create the first admin user in DB on first run)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"

# Random 32+ character string used to sign the login cookie
# generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# ── Khandesh Maratha Mandal Branding ──────────────────────────────────────────
# These appear on every bio-data sheet header and the login page

# Event title (Marathi)
NEXT_PUBLIC_EVENT_TITLE_MR="मराठा वधू-वर मेळावा"

# Organisation name (Marathi) — shown as big banner on bio-data sheet
NEXT_PUBLIC_ORG_NAME_MR="खान्देश मराठा मंडळ"

# Sub-region name
NEXT_PUBLIC_ORG_SUBNAME_MR="पिंपरी चिंचवड व पुणे जिल्हा परिसर"

# Establishment date (Marathi numerals)
NEXT_PUBLIC_STHAPANA="स्थापना : १ मे १९८६"

# Registration number (as on the image banner)
NEXT_PUBLIC_REG_NO="र. नं. महाराष्ट्र २८८९/८६ एफ ३९७८-पुणे"

# Jai slogans shown on bio-data header
NEXT_PUBLIC_JAI1="जय जिजाऊ"
NEXT_PUBLIC_JAI2="जय शिवराय"

# Contact info shown in bio-data footer
NEXT_PUBLIC_ORG_CONTACT="संपर्क: ९९९९९ ९९९९९"

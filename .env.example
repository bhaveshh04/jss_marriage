# Neon: Dashboard > Connection Details > copy the pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Admin login (one operator account)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"

# Random 32+ character string used to sign the login cookie
# generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Names printed at the top/bottom of every bio-data (Marathi)
NEXT_PUBLIC_EVENT_TITLE_MR="मराठा वधू-वर मेळावा"
NEXT_PUBLIC_ORG_NAME_MR="मराठा वधू-वर सूचक केंद्र"
NEXT_PUBLIC_ORG_CONTACT="संपर्क: ९९९९९ ९९९९९"
